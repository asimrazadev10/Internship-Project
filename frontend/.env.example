# Copy to .env.local and adjust. Never commit .env.local.

# Origin of the NestJS backend. Next proxies /api/* here (next.config.ts).
BACKEND_ORIGIN=http://localhost:3000

# Google OAuth client id for "Continue with Google" (optional — the button hides if unset).
# Must equal the backend's GOOGLE_CLIENT_ID; this app's origin must be an Authorized JavaScript
# origin in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Backend origin for the WebSocket (direct, not via the /api proxy — sockets don't proxy).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Public origin of THIS app. Used as metadataBase so the generated Open Graph image resolves to an
# absolute URL — crawlers require that, and without it shared links render no preview.
# NOTE: NEXT_PUBLIC_* vars are inlined at BUILD time, so this must be set before `next build`,
# not at container start.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

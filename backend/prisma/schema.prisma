// Group Chat Application — data model
//
// Design rationale for every decision below is recorded in
// docs/superpowers/specs/2026-07-20-database-schema-design.md
//
// Three conventions applied throughout:
//
//   @default(uuid(7))    — time-ordered UUIDs, so B-tree inserts stay sequential instead of
//                          scattering across pages the way random v4 values do.
//   @db.Uuid             — native 16-byte Postgres uuid column. Without it Prisma creates a
//                          `text` column holding the 36-character string (~37 bytes).
//   @db.Timestamptz(3)   — instant-in-time, stored as UTC. Prisma's default DateTime maps to
//                          `timestamp without time zone`, which is a wall-clock reading with
//                          no offset. NOW() returns timestamptz, so Phase 4's
//                          `createdAt >= NOW() - INTERVAL '24 HOURS'` would compare the two
//                          via an implicit cast using whatever the server's TimeZone happens
//                          to be. With a UTC container, a PKT developer machine and four
//                          independent Phase 5 workers, that is three ways to disagree about
//                          when "yesterday" started. Both types cost 8 bytes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  USER
  SYSTEM
  AI_SUMMARY
}

model User {
  id         String       @id @default(uuid(7)) @db.Uuid
  email      String       @unique
  // Null for OAuth-only accounts, which have no local password to verify.
  password   String?
  name       String
  provider   AuthProvider @default(LOCAL)
  // Google's stable `sub` claim. Identity is matched on this, never on email:
  // emails change, and trusting an unverified provider email is an account-takeover vector.
  providerId String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  memberships   GroupMember[]
  messages      Message[]
  createdGroups Group[]        @relation("GroupCreator")
  refreshTokens RefreshToken[]
  reactions     Reaction[]

  @@unique([provider, providerId])
}

model Group {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdBy String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // Restrict, not Cascade: deleting a user who still owns groups should fail loudly rather
  // than silently destroying every member's conversation history.
  creator  User          @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  members  GroupMember[]
  messages Message[]

  @@index([createdAt])
}

model GroupMember {
  id       String     @id @default(uuid(7)) @db.Uuid
  groupId  String     @db.Uuid
  userId   String     @db.Uuid
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now()) @db.Timestamptz(3)
  // Read receipts (bonus): the instant this member last marked the group read. Null = never.
  lastReadAt DateTime? @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevents double-joining, and is the index the membership authorization check reads.
  @@unique([groupId, userId])
  // "Which groups am I in" — Postgres does not auto-index foreign key columns.
  @@index([userId])
}

model Message {
  id       String  @id @default(uuid(7)) @db.Uuid
  groupId  String  @db.Uuid
  // Null for SYSTEM and AI_SUMMARY messages, which have no human sender.
  senderId String? @db.Uuid

  content   String      @db.Text
  type      MessageType @default(USER)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  // Bonus: edit & (soft) delete. editedAt marks an edited message; deletedAt tombstones it
  // (the row stays so history renders a "deleted" placeholder rather than a gap).
  editedAt  DateTime?   @db.Timestamptz(3)
  deletedAt DateTime?   @db.Timestamptz(3)

  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a user must not erase the conversation for everyone else.
  sender    User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)
  reactions Reaction[]

  // Keyset pagination. Column order is deliberate: equality predicate (groupId) first, then
  // the range/sort predicate (createdAt), then id purely as a unique tiebreaker so the
  // cursor comparison resolves inside the index instead of fetching heap rows.
  @@index([groupId, createdAt, id])
  // Without this, onDelete: SetNull has to scan every message to find one user's.
  @@index([senderId])
}

model RefreshToken {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @db.Uuid
  // SHA-256 of the token, never the token itself, so a database leak yields nothing usable.
  // A slow hash (bcrypt/argon2) buys nothing here: the token is already high-entropy random,
  // so there is no low-entropy secret to brute-force — only latency on a hot path.
  tokenHash String @unique
  // Rotation family. Every refresh issues a new token in the same family and revokes the old
  // one; if an already-revoked token is ever presented, the family is compromised and all of
  // its tokens are revoked at once.
  familyId String @db.Uuid

  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Bonus feature — message reactions. A user may add a given emoji to a message at most once.
model Reaction {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId])
}

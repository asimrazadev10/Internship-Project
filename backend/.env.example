# Copy to .env and fill in. Never commit .env.
# Config is validated at startup — the app should refuse to boot on a missing/invalid value
# rather than failing later at the first request that needs it.

# ---------- App ----------
PORT=3000
NODE_ENV=development

# ---------- Docker Compose (consumed by docker-compose.yml) ----------
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=chatpass
POSTGRES_DB=chatdb
POSTGRES_PORT=5432

# ---------- Database ----------
# Must match the POSTGRES_* values above when using docker-compose.
DATABASE_URL=postgresql://chatuser:chatpass@localhost:5432/chatdb?schema=public

# ---------- JWT ----------
# Generate with: openssl rand -base64 48
# Access and refresh MUST use different secrets, so a leaked access secret cannot be used
# to mint refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Google OAuth ----------
# Token-exchange flow: the frontend obtains a Google ID token and POSTs it to /auth/google;
# the backend verifies it. Only the client id is needed — it is the `audience` the token must
# carry. There is no authorization-code exchange, so no client secret and no callback URL.
GOOGLE_CLIENT_ID=

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Gemini (Phase 4+) — AI daily summaries ----------
# Free key from https://aistudio.google.com/apikey (Generative Language API via @ai-sdk/google,
# NOT paid Vertex). GEMINI_MODEL/SUMMARY_* have working defaults; only the key must be set.
GOOGLE_GENERATIVE_AI_API_KEY=placeholder-set-real-key-for-demo
GEMINI_MODEL=gemini-2.0-flash
# Scheduler tick + how far back each summary looks, in ms. Default 24h; set small (e.g. 60000)
# to demo without waiting a full day.
SUMMARY_INTERVAL_MS=86400000
SUMMARY_WINDOW_MS=86400000
# Global cap on Gemini calls, enforced by the ai-queue's Redis-coordinated limiter — so it holds
# across every ai-worker instance, unlike AI_WORKER_CONCURRENCY which is per-process. Defaults are
# free AI-Studio-tier figures; raise them for a paid key.
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_DURATION_MS=60000

# ---------- Socket.IO (Phase 3+) ----------
SOCKET_CORS_ORIGIN=http://localhost:3001

# ---------- Worker concurrency (Phase 5) ----------
# Read at startup so throughput can be tuned per environment without code changes.
SCHEDULER_WORKER_CONCURRENCY=1
SUMMARY_WORKER_CONCURRENCY=5
AI_WORKER_CONCURRENCY=10
NOTIFICATION_WORKER_CONCURRENCY=3

# ---------- Supabase Storage (Bonus) — file uploads ----------
# Optional. Leave SUPABASE_URL/SUPABASE_SERVICE_KEY unset and uploads still work — StorageService
# falls back to writing under uploads/ on local disk, served back via the backend's static route.
# (A 503 only ever comes from a Supabase POST that fails, not from these being absent.) For the
# Supabase path, create a Storage bucket (public, so the returned URLs load directly), then set:
#   SUPABASE_URL          Project URL, e.g. https://xxxx.supabase.co
#   SUPABASE_SERVICE_KEY  service_role key — SERVER-SIDE ONLY, never expose to the browser
#   SUPABASE_BUCKET       bucket name; the schema defaults it to "chat-uploads"
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=chat-uploads
